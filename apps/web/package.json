{
    "name": "@ci-calendar/web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && tsc -p src/sw && vite build && node scripts/check-headers.mjs",
        "lint": "eslint . --report-unused-disable-directives",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw && tsc --noEmit -p worker && tsc --noEmit -p tsconfig.node.json",
        "gen:types": "supabase gen types typescript --project-id pjgwpivkvsuernmoeebk > src/data/database.types.ts && prettier --write src/data/database.types.ts",
        "preview": "vite preview",
        "check:bundle": "node scripts/bundle-size.mjs",
        "check:sw": "node scripts/check-sw.mjs",
        "check:headers": "node scripts/check-headers.mjs",
        "cf:dev": "npm run build && wrangler dev",
        "cf:deploy": "npm run build && wrangler deploy",
        "cf:preview": "npm run build && wrangler versions upload",
        "cf:check": "wrangler deploy --dry-run"
    },
    "engines": {
        "node": "22.x"
    },
    "dependencies": {
        "@sentry/react": "^11.10.0",
        "@supabase/auth-js": "^2.118.0",
        "@supabase/functions-js": "^2.118.0",
        "@supabase/postgrest-js": "^2.118.0",
        "@supabase/storage-js": "^2.118.0",
        "@tanstack/react-query": "^5.105.0",
        "heic-to": "^1.6.7",
        "posthog-js": "^1.204.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-easy-crop": "^6.2.4",
        "react-router": "^7.18.5"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261031.1",
        "@eslint/js": "^9.39.5",
        "@sentry/vite-plugin": "^11.10.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/node": "^22.10.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.4.19",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jsdom": "^26.1.0",
        "postcss": "^8.5.32",
        "rollup-plugin-visualizer": "^7.1.1",
        "sass": "^1.83.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "vite": "^8.3.5",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.5",
        "workbox-core": "^7.4.0",
        "workbox-precaching": "^7.4.0",
        "workbox-routing": "^7.4.0",
        "wrangler": "^4.156.0"
    },
    "bundleBudget": {
        "initialJsGzipKb": 150
    }
}
