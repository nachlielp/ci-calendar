# Copy to `.env` and fill in real values. Never commit `.env`.
# Every VITE_-prefixed variable is inlined into the public client bundle —
# only put values here that are safe to expose in the browser.

# --- Supabase ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# The bucket bio photos are uploaded to (production: ci_bio_profiles); the
# client builds their public URLs from VITE_SUPABASE_URL and this.
VITE_SUPABASE_STORAGE_BUCKET=your-storage-bucket

# --- Google Places (address autocomplete + place details) ---
# This key IS shipped to the browser, so it MUST be locked down in the Google
# Cloud console: HTTP-referrer restricted to the production domain(s) and
# scoped to the Places/Maps JS APIs ONLY. It must NOT have the Translate API
# enabled — runtime translation goes through the `translate` Supabase Edge
# Function, which holds a separate server-side key (see
# supabase/functions/translate/README.md).
VITE_GOOGLE_PLACES_API_KEY=your-referrer-restricted-places-key

# --- Analytics: PostHog (src/app/telemetry) ---
# Loaded after the first paint, in production builds on the production site
# (ci-events.org) only, never on devices marked `isInternal`. No analytics
# when the key is unset. The host defaults to https://app.posthog.com.
VITE_PUBLIC_POSTHOG_KEY=phc_your_key
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Analytics: Cloudflare Web Analytics (src/app/telemetry) ---
# The site token from Cloudflare's Web Analytics snippet (public). Loaded with
# PostHog's rules (production site, not internal devices). No beacon when
# unset.
VITE_CF_ANALYTICS_TOKEN=your-web-analytics-token

# Google Analytics needs no variable: its tag id is in index.html.

# --- Error tracking: Sentry (runtime, src/app/telemetry) ---
# Production builds only (any host; previews report as "preview"). No crash
# reports when unset.
VITE_SENTRY_DSN=https://your-dsn.ingest.sentry.io/xxxx

# --- Feature flags / config ---
# Set to "true" to build the maintenance page ("closed for maintenance" on
# every path) instead of the app; deploy again without it to reopen.
VITE_DISABLE_APP=false
# Set to "true" to make new events start hidden (the form's hide switch on).
VITE_HIDE_EVENTS_FLAG=false
# Comma-separated language codes to show in the switcher (e.g. he,en,ru).
VITE_LANGUAGES_TO_SHOW=he,en,ru

# --- Build-time only (NOT shipped to the browser) ---
# Sentry release/sourcemap upload. When unset, the Sentry build plugin is
# skipped entirely (see vite.config.ts). Source maps are uploaded under the
# build version (below), the release the app reports.
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# The build version is the commit SHA: Workers Builds sets
# WORKERS_CI_COMMIT_SHA and GitHub Actions GITHUB_SHA (else
# `git rev-parse HEAD`). Don't set them here.
# ANALYZE=true opens the bundle analyzer after `npm run build`.
