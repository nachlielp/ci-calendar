{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "allowJs": true,
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src/**/*", "scripts/**/*", "worker/**/*"],
    // The service worker has worker globals, not the DOM: src/sw/tsconfig.json.
    // So has the Cloudflare Worker's entry: worker/tsconfig.json.
    "exclude": ["src/sw/sw.ts", "worker/index.ts"]
    // vite.config.ts runs in Node: tsconfig.node.json (`npm run typecheck`).
}
