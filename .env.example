# Copy to `.env` and fill in real values. Never commit `.env`.
# Every VITE_-prefixed variable is inlined into the public client bundle —
# only put values here that are safe to expose in the browser.

# --- Supabase ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_STORAGE_BUCKET=your-storage-bucket
VITE_SUPABASE_BIO_STORAGE_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public/your-bucket

# --- Auth ---
# localStorage key used to detect the persisted Supabase session.
VITE_AUTH_KEY_NAME=your-supabase-auth-storage-key

# --- Google Maps / Places (geocoding + address autocomplete) ---
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# --- Analytics: PostHog ---
VITE_PUBLIC_POSTHOG_KEY=phc_your_key
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Analytics: Google Analytics ---
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# --- Error tracking: Sentry (runtime) ---
VITE_SENTRY_DSN=https://your-dsn.ingest.sentry.io/xxxx

# --- Feature flags / config ---
# Deployment branch label (e.g. main / develop).
VITE_BRANCH=develop
# Set to "true" to render the app-disabled kill switch.
VITE_DISABLE_APP=false
# Set to "true" to hide events globally.
VITE_HIDE_EVENTS_FLAG=false
# Comma-separated language codes to show in the switcher (e.g. he,en,ru).
VITE_LANGUAGES_TO_SHOW=he,en,ru
# Set to "true" to enable PWA behavior in non-production testing.
VITE_PWA_TEST=false
# WhatsApp contact number for support links.
VITE_WHATSAPP_NUMBER=972500000000

# --- Build-time only (NOT shipped to the browser) ---
# Sentry release/sourcemap upload. When unset, the Sentry build plugin is
# skipped entirely (see vite.config.ts).
SENTRY_AUTH_TOKEN=your-sentry-auth-token
