        "@vercel/speed-insights": "^1.0.11",
        "antd": "^5.16.1",
        "dayjs": "^1.11.13",
        "mobx": "^6.13.5",
        "mobx-react-lite": "^4.0.7",
        "posthog-js": "^1.204.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
