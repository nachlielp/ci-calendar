{
    "name": "ci-calendar",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && tsc -p src/sw && vite build",
        "lint": "eslint . --report-unused-disable-directives",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw",
        "gen:types": "supabase gen types typescript --project-id pjgwpivkvsuernmoeebk > src/data/database.types.ts && prettier --write src/data/database.types.ts",
        "preview": "vite preview",
        "check:bundle": "node scripts/bundle-size.mjs",
        "check:sw": "node scripts/check-sw.mjs"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@sentry/react": "^8.47.0",
        "@sentry/vite-plugin": "^2.22.7",
        "@supabase/auth-js": "^2.118.0",
        "@supabase/functions-js": "^2.118.0",
        "@supabase/postgrest-js": "^2.118.0",
        "@supabase/storage-js": "^2.118.0",
        "@tanstack/react-query": "^5.105.0",
        "@vercel/speed-insights": "^1.0.11",
        "posthog-js": "^1.204.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-easy-crop": "^5.2.0",
        "react-router": "^7.13.1",
        "vite-plugin-pwa": "^1.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/node": "^22.10.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.19",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^15.15.0",
        "jsdom": "^26.1.0",
        "postcss": "^8.4.38",
        "prettier": "^3.9.6",
        "rollup-plugin-visualizer": "^5.12.0",
        "sass": "^1.83.1",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.66.0",
        "vite": "^6.4.1",
        "vitest": "^3.2.7",
        "workbox-core": "^7.4.0",
        "workbox-precaching": "^7.4.0",
        "workbox-routing": "^7.4.0"
    },
    "overrides": {
        "immutable": ">=5.1.5",
        "lodash": ">=4.17.23",
        "minimatch": ">=9.0.7",
        "eslint-plugin-jsx-a11y": {
            "minimatch": "^3.1.2"
        },
        "serialize-javascript": ">=7.0.3"
    },
    "bundleBudget": {
        "initialJsGzipKb": 150
    }
}
