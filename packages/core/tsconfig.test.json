{
    // The core's tests and its fake backend kit (src/testing): the same
    // rules, plus Node's types (Vitest, and the mobile app's Jest, run them
    // on Node). Kept apart so Node's globals never reach the source's check.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node"]
    },
    "include": [
        "src/**/*",
        "vitest.config.ts",
        "vitest.setup.ts",
        "eslint.config.js"
    ],
    "exclude": ["src/platform.d.ts"]
}
