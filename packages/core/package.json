{
    "name": "@ci-calendar/core",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "description": "Logic shared by the web and mobile apps: no React, no DOM, no React Native. Shipped as TypeScript source; each app's bundler compiles it.",
    "sideEffects": false,
    "exports": {
        "./*": "./src/*.ts"
    },
    "scripts": {
        "gen:types": "supabase gen types typescript --project-id pjgwpivkvsuernmoeebk > src/data/database.types.ts && prettier --write src/data/database.types.ts",
        "lint": "eslint . --report-unused-disable-directives",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
    },
    "engines": {
        "node": "22.x"
    },
    "dependencies": {
        "@supabase/auth-js": "^2.118.0",
        "@supabase/functions-js": "^2.118.0",
        "@supabase/postgrest-js": "^2.118.0",
        "@supabase/storage-js": "^2.118.0",
        "@tanstack/query-core": "^5.105.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.10.2",
        "eslint": "^9.39.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "vitest": "^5.0.5"
    }
}
